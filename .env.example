# Copy to backend/.env. Keep the real key only there.
FISH_AUDIO_API_KEY=your_fish_audio_key_here
FISH_AUDIO_MODEL=s2.1-pro-free
# Required for AI previews and transcription, including localhost.
# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set a unique value of at least 32 characters; share privately with demo users.
DEMO_ACCESS_TOKEN=
# Migration default: existing demo protection remains active.
AI_ACCESS_MODE=demo
# Public mode also requires a Redis budget initialized/enabled by the operator CLI.
PUBLIC_GENERATIONS_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate independently from the demo token, at least 32 random characters.
# Keep stable across deployments so IP allowances do not reset.
PUBLIC_IP_HASH_SECRET=
# Local: peer (run uvicorn with --no-proxy-headers).
# Render: render, only after confirming its edge overwrites True-Client-IP.
PUBLIC_IP_SOURCE=peer
PUBLIC_RENDER_IP_VERIFIED=false
# Optional if ffmpeg / ffprobe are not on PATH:
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
